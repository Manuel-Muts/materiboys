rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended != true;
    }

    function hasSchoolId() {
      return request.resource.data.schoolId is string && request.resource.data.schoolId.size() > 0;
    }

    function matchesSchoolPath(schoolId, resourceData) {
      return resourceData != null && resourceData.schoolId == schoolId;
    }

    function canReadSchoolData(schoolId) {
      return true;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();

      match /news-posts/{postId} {
        allow read: if canReadSchoolData(schoolId);
        allow create: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow update: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow delete: if isAdmin() && resource.data.schoolId == schoolId;
      }

      match /alumni-registrations/{registrationId} {
        allow read: if canReadSchoolData(schoolId);
        allow create: if request.resource.data.schoolId == schoolId;
        allow update: if isAdmin() && request.resource.data.schoolId == schoolId;
        allow delete: if isAdmin() && resource.data.schoolId == schoolId;
      }

      match /vacancies/{vacancyId} {
        allow read: if canReadSchoolData(schoolId);
        allow create: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow update: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow delete: if isAdmin() && resource.data.schoolId == schoolId;
      }

      match /documents/{documentId} {
        allow read: if canReadSchoolData(schoolId);
        allow create: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow update: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow delete: if isAdmin() && resource.data.schoolId == schoolId;
      }

      match /site-settings/{settingsId} {
        allow read: if canReadSchoolData(schoolId);
        allow create: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow update: if isAdmin() && hasSchoolId() && request.resource.data.schoolId == schoolId;
        allow delete: if isAdmin() && resource.data.schoolId == schoolId;
      }
    }
  }
}
